    <IsAnalyzerProject>true</IsAnalyzerProject>
    <PolyTypeRoslynPublic>true</PolyTypeRoslynPublic>
    <_PolyTypeRoslynSourceRoot>$(MSBuildThisFileDirectory)..\..\</_PolyTypeRoslynSourceRoot>
  </PropertyGroup>

  <Import Project="..\..\PolyType.Roslyn\build\PolyType.Roslyn.targets" />

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>
</Project>
