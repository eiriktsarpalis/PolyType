<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <DefineConstants Condition="'$(LaunchDebugger)' == 'true'">$(DefineConstants);LAUNCH_DEBUGGER</DefineConstants>
    <IsAnalyzerProject>true</IsAnalyzerProject>
    <PolyTypeRoslynPublic>true</PolyTypeRoslynPublic>
    <_PolyTypeRoslynSourceRoot>$(MSBuildThisFileDirectory)..\</_PolyTypeRoslynSourceRoot>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\PolyType\TypeShapeKind.cs" Link="Shared\PolyType\%(Filename).cs" />
    <Compile Include="..\PolyType\MethodShapeFlags.cs" Link="Shared\PolyType\%(Filename).cs" />
    <Compile Include="..\PolyType\SourceGenModel\Helpers\ValueBitArray.cs" Link="Shared\PolyType\SourceGenModel\Helpers\%(Filename).cs" />
    <Compile Include="..\Shared\Polyfills\FSharpSourceConstructFlags.cs" Link="Shared\Polyfills\%(Filename).cs" />
  </ItemGroup>

  <Import Project="..\PolyType.Roslyn\build\PolyType.Roslyn.targets" />

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" Pack="false" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>
</Project>