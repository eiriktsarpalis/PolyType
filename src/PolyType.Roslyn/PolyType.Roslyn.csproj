<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAnalyzerProject>true</IsAnalyzerProject>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <!-- Source-only packages have dependencies but no matching lib/ref assemblies. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>14.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PolyTypeRoslynPublic>true</PolyTypeRoslynPublic>
    <_PolyTypeRoslynSourceRoot>$(MSBuildThisFileDirectory)..\</_PolyTypeRoslynSourceRoot>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" pack="true" PackagePath="." />
    <None Include="$(RepoRoot).github\skills\author-polytype-generator\SKILL.md" Pack="true" PackagePath="skills/author-polytype-generator/SKILL.md" />
    <None Include="$(RepoRoot)LICENSE" Pack="true" PackagePath="." />
    <None Update="build\PolyType.Roslyn.targets" Pack="true" PackagePath="build\PolyType.Roslyn.targets" />
    <None Update="build\source.editorconfig" Pack="true" PackagePath="src\.editorconfig" />
  </ItemGroup>
    
  <Import Project="build\PolyType.Roslyn.targets" />

  <ItemGroup>
    <None Include="@(_PolyTypeRoslynSource)" Pack="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- Use a version of Roslyn that is compatible with VS 2019 -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="3.11.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>