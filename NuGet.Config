<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="polytype-dotnet-tools" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-tools/nuget/v3/index.json" />
  </packageSources>
  <!-- Ambient sources must map other packages, and Microsoft.CodeAnalysis.* for released Roslyn versions. -->
  <packageSourceMapping>
    <packageSource key="polytype-dotnet-tools">
      <package pattern="Microsoft.CodeAnalysis.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
